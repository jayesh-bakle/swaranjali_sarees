# ── Frontend API Configuration ─────────────────────────
# Points to your backend API base URL (without /api)
# Local development:
VITE_API_URL=http://localhost:5000/api

# Production (replace with your deployed Render backend URL):
# VITE_API_URL=https://your-backend.onrender.com/api

# ── Google Analytics 4 (optional) ──────────────────────
# Paste your GA4 Measurement ID (G-XXXXXXX) to enable analytics.
# Baked in at build time — no analytics when unset.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXX