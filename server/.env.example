# ── Server Configuration ──────────────────────────────
PORT=5000

# ── JWT Secret (REQUIRED - change in production) ──────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# ── Default admin account (seeded on first run) ───────
# Optional overrides. Defaults to admin@sarees.com / admin123, which is
# FORCE-CHANGED on first login — the default password never stays live.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Razorpay API Keys (REQUIRED for online payments) ──
# Get these from https://dashboard.razorpay.com
# Use test keys for development: https://razorpay.com/docs/payments/payments/test-instructions/
# ⚠️ Copy this file to .env and fill in your real keys — .env is gitignored
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Webhook secret for server-side payment confirmation
# See: https://razorpay.com/docs/webhooks/
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Database (production: Turso free cloud SQLite) ─────
# FREE, permanent, SQLite-compatible. Sign up: https://turso.tech
#   brew install turso            (macOS)  |  curl -sSfL https://get.turso.tech/install.sh | bash  (Windows/Linux)
#   turso auth login
#   turso db create sarees_db
#   turso db show sarees_db --url          → TURSO_DATABASE_URL
#   turso db tokens create sarees_db       → TURSO_AUTH_TOKEN
# When BOTH are set, the server uses Turso. Leave empty for local SQLite (development).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Fallback for local/dev SQLite file location
DATABASE_PATH=

# ── Image Storage (production: Cloudinary free) ────────
# FREE 25 GB storage / 25 GB bandwidth. Sign up: https://cloudinary.com
# Dashboard → your Cloud name, API Key, API Secret (copy from "Account" → "API Keys")
# When ALL THREE are set, product images upload to Cloudinary permanently (no local disk).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Sheets (order logging — 100% free) ──────────
# Logs every order to a Google Sheet in real-time.
# Setup guide:
#   1. Create a Google Sheet, add headers in Row 1:
#      Order ID | Date | Customer Name | Email | Phone | Address | Product ID | Product Name | Fabric | Color | Qty | Unit Price | Line Total | Payment Method | Payment Status | Order Status | Order Total
#   2. Copy the Sheet ID from the URL (the long string between /d/ and /edit)
#   3. Create a Google Cloud Service Account, enable Sheets API, download JSON key
#   4. Share the sheet with the service account email (Editor access)
#   5. Paste the entire JSON key as a single line below (use https://jsonformatter.org/json-to-one-line)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed origins. In production, unset means cross-origin
# requests are DENIED (fail closed) — set this to your frontend origin(s).
# In development it defaults to allow-all for convenience.
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ── Reviews (optional) ─────────────────────────────────
# Set to true to require that a customer actually purchased the product
# before they can review it. Defaults to false (any logged-in customer can review).
# REQUIRE_PURCHASE_FOR_REVIEWS=true

# ── Order + password-reset emails (optional) ───────────
# Sends order confirmation AND password-reset emails via an SMTP provider
# (e.g. Gmail App Password). Leave unset to skip emails entirely — the
# reset link is then only logged to the server console.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=you@gmail.com
# MAIL_PASS=your_app_password
# MAIL_FROM="Jagmohini Paithani <you@gmail.com>"

# ── Frontend URL ───────────────────────────────────────
# Base URL of the frontend SPA — used to build absolute password-reset links
# in the forgot-password email. Defaults to the Render frontend URL.
# FRONTEND_URL=https://jagmohini-paithani.onrender.com
